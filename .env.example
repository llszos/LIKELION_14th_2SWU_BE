DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
JWT_ISSUER=gyeot
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/auth
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:3000

INVITATION_BASE_URL=http://localhost:3000/invitations

# 안심카드 암호화 키: Base64로 인코딩한 32바이트 난수 (로컬에서도 필수)
# 로컬 DB는 각자 따로 쓰므로 키도 각자 만들어 쓰고 공유하지 않습니다. 개발 서버는 서버 .env의 키를 사용합니다.
# PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Bash: openssl rand -base64 32
# 키를 바꾸면 기존에 암호화한 데이터를 복호화할 수 없으므로, 한 번 만든 키를 IntelliJ Run Configuration 환경변수 등에 저장해 계속 사용합니다.
SAFETY_INFO_ENCRYPTION_KEY=
