# 개발 서버(EC2)의 ~/gyeot/.env 예시. 실제 값은 서버에만 둡니다.
IMAGE_TAG=latest

DB_URL=jdbc:mysql://<RDS 엔드포인트>:3306/gyeot?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=admin
DB_PASSWORD=

# #33 병합 후 필수 (Base64 256비트 이상)
JWT_SECRET=

# 안심카드 암호화 키 (#37에서 사용, 자리만 먼저 준비)
SAFETY_INFO_ENCRYPTION_KEY=

# PR #33 병합 후 필수: prod 설정에 기본값이 없어서, 없으면 앱이 시작되지 않음
# 허용할 프론트 주소. 지금은 프론트 로컬 개발 서버, 도메인 확정 후(#81) 실제 프론트 주소로 변경 (여러 개면 쉼표로 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PR #82 병합 후 필수: prod 설정에 기본값이 없어서, 없으면 앱이 시작되지 않음
# 초대 링크의 프론트 기본 경로. 지금 값은 로컬 개발용(localhost = 링크를 연 사람의 PC)
# 실제 공유 테스트 시 접근 가능한 프론트 주소로 변경. 도메인 확정 후(#81) 해당 주소 사용
INVITATION_BASE_URL=http://localhost:5173/invitations

# Refresh 쿠키 Secure 여부. 적지 않으면 prod 기본값 true (HTTPS 응답에서만 브라우저가 쿠키를 저장)
# 지금 서버는 HTTP라 쿠키 기반 재발급은 HTTPS 적용(#81) 후부터 동작. false로 바꾸지 말고 HTTPS로 해결
# COOKIE_SECURE=true

# Flyway V1 적용 전(#47)까지 개발 서버만 테이블 자동 생성
SPRING_JPA_HIBERNATE_DDL_AUTO=update
